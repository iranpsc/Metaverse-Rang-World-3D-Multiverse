            "clientMaxMsgsPerTick": 1000,
            "sendTimeout": 5000,
            "receiveTimeout": 20000,
            "noDelay": true,

            "sslEnabled": false,
            "sslProtocols": 3072,
            "sslCertJson": "./cert.json",

            "port": 7781,
            "batchSend": true,
            "waitBeforeSend": true,

            "clientUseWss": true,
            "clientPortOption": 1
        }
    },
    "Discovery":{
        "EnableDiscovery": true,
        "BroadCastAddress": "3ddevelop.irpsc.com/game",
        "BroadCastPort": 27777,
        "DiscoveryInterval": 3
