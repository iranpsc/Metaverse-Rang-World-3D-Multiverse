{
    "General":{
        "dontDestroyOnLoad": true,
        "runInBackground": true,
        "headlessStartMode": 1,
        "editorAutoStart": false,
        "sendRate": 60,
        "offlineSceneLoadDelay": 0,
        "transport": 1,
        "networkAddress": "3ddevelop.irpsc.com/game",
